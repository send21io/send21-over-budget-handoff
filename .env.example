# Copy to .env and fill in. Never commit .env.
SEND21_MODE=mock
# Live only. Create at https://send21.io/api-keys with the drafts:write scope ONLY.
SEND21_API_KEY=<your-drafts-write-key>
# Signing secret shown once when you create the webhook endpoint. Mock mode uses a local default.
SEND21_WEBHOOK_SECRET=<your-webhook-signing-secret>
SEND21_MCP_URL=https://send21.io/mcp
# Your own receiving address. The agent never holds keys.
PAYEE_ADDRESS=<your-receiving-address>
PAYEE_CURRENCY=Usdc
PAYEE_NETWORK=Base
BUDGET_CAP=5.00
BUDGET_SPENT=4.20
BUDGET_CURRENCY=USD
HANDOFF_AMOUNT_MODE=cost
WEBHOOK_PORT=3000
